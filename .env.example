APP_NAME=Invoicly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Behind TLS termination (e.g. Dockploy), use https://your-domain and trustProxies in bootstrap/app.php so @vite and URLs stay HTTPS.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=invoicly
DB_USERNAME=postgres
DB_PASSWORD=

# Local development without PostgreSQL: use sqlite instead
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Reminders/notifications send real mail in production — use a real SMTP relay.
# For local development a mail catcher works too (e.g. Mailpit on port 1025,
# or set MAIL_MAILER=log to write messages to storage/logs instead of sending).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# Smart reminders — channel preference order + timing. Leave defaults for most.
# INVOICLY_REMINDER_CHANNELS=email,whatsapp,sms,slack
# INVOICLY_REMINDER_LEAD_DAYS=3
# INVOICLY_REMINDER_OVERDUE_INTERVAL_DAYS=7
# INVOICLY_REMINDER_MAX_OVERDUE=4

# Twilio (SMS + WhatsApp reminders) — one integration for both channels.
# WhatsApp also needs pre-approved Content template SIDs (business-initiated
# messages are outside the 24h session window and must use a template).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_UPCOMING=
TWILIO_WHATSAPP_CONTENT_OVERDUE=
TWILIO_STATUS_CALLBACK=

# Slack reminders post to the bot's default channel (owner-facing fallback).
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# spatie/laravel-pdf — publish: php artisan vendor:publish --tag=laravel-pdf-config
# dompdf: composer require dompdf/dompdf | browsershot: composer require spatie/browsershot
LARAVEL_PDF_DRIVER=dompdf
